# BotStackHQ — Frontend (.env template)
#
# Copy this file to `.env` for local development. `.env` is gitignored.
#
# Vite only exposes variables prefixed with `VITE_` to client code, so
# **every value here is shipped to the browser**. Do NOT put secrets in
# this file or in any `.env*` consumed by Vite.

# ---- Environment ------------------------------------------------------------
VITE_ENVIRONMENT=development     # development | staging | production

# ---- Backend API ------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:3000/v1   # NestJS REST base; all routes are /v1 prefixed
VITE_WS_URL=ws://localhost:3000/ws           # WebSocket endpoint for real-time updates

# ---- Auth (AuthKit / WorkOS — public values only) --------------------------
VITE_AUTHKIT_CLIENT_ID=          # public WorkOS client ID
VITE_AUTHKIT_DOMAIN=             # e.g. your-org.authkit.app (hosted UI domain)
VITE_AUTHKIT_REDIRECT_URI=http://localhost:5173/auth/callback
