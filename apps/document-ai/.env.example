# BotStackHQ — Document AI (.env template)
#
# Copy this file to `.env` for local development. `.env` is gitignored.
#
# Secrets policy (ADD §16.3): production secrets live in AWS Secrets
# Manager — never in this file. Variables ending in `_SECRET_NAME` are the
# Secrets Manager secret name/ARN the service resolves at runtime. For
# local dev, put plain values in `.env` against the matching non-suffix
# variable.

# ---- Runtime ----------------------------------------------------------------
DOC_AI_PORT=8000                 # uvicorn port for local dev (Lambda ignores)
LOG_LEVEL=info                   # error | warn | info | debug

# ---- AWS --------------------------------------------------------------------
AWS_REGION=ap-south-1            # Mumbai — locked by data residency

# ---- Object storage (S3) ----------------------------------------------------
DOCUMENTS_S3_BUCKET=             # must match the backend bucket; service only
                                 # reads keys under workspaces/{workspace_id}/...

# ---- Queue ingress (SQS) ----------------------------------------------------
SQS_DOC_PROCESSING_QUEUE_URL=    # the queue this Lambda is triggered by

# ---- LLM provider (Secrets Manager ref in prod) ----------------------------
OPENAI_API_KEY_SECRET_NAME=      # prod: Secrets Manager secret name/ARN
OPENAI_API_KEY=                  # local dev only — leave blank in committed template

# ---- OCR --------------------------------------------------------------------
TESSERACT_CMD=                   # absolute path to tesseract binary if not on PATH
