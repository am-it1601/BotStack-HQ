# BotStackHQ — Backend (.env template)
#
# Copy this file to `.env` for local development and fill in real values.
# `.env` is gitignored; this template is the canonical reference.
#
# Secrets policy (ADD §16.3): production secrets MUST live in AWS Secrets
# Manager — never in this file. In prod, the variables ending in
# `_SECRET_NAME` hold the Secrets Manager secret name/ARN; the backend
# resolves them at runtime. For local dev only, you can place plain values
# in `.env` against the matching non-suffix variable.

# ---- Runtime ----------------------------------------------------------------
NODE_ENV=development            # development | staging | production
PORT=3000                       # local Express port (ignored on Lambda)
LOG_LEVEL=info                  # error | warn | info | debug

# ---- AWS --------------------------------------------------------------------
AWS_REGION=ap-south-1           # Mumbai — locked by data residency
AWS_ACCOUNT_ID=                 # 12-digit account ID

# ---- Database (RDS PostgreSQL 16 + pgvector) --------------------------------
# Local dev: full URL against your local Postgres or RDS bastion.
# Prod: leave blank; backend reads credentials from DATABASE_SECRET_NAME.
DATABASE_URL=postgresql://botstackhq:botstackhq@localhost:5432/botstackhq
DATABASE_SECRET_NAME=           # e.g. botstackhq/prod/rds/credentials

# ---- Auth (AuthKit / WorkOS) -----------------------------------------------
AUTHKIT_DOMAIN=                 # e.g. your-org.authkit.app
AUTHKIT_CLIENT_ID=              # public WorkOS client ID
AUTHKIT_API_KEY_SECRET_NAME=    # Secrets Manager secret holding the WorkOS API key
AUTHKIT_JWKS_URL=               # JWKS endpoint for JWT verification at the API gateway

# ---- Object storage (S3) ----------------------------------------------------
DOCUMENTS_S3_BUCKET=            # e.g. botstackhq-documents-prod
DOCUMENTS_S3_KMS_KEY_ID=        # KMS key for at-rest encryption (alias or ARN)

# ---- Async queues (SQS) -----------------------------------------------------
SQS_DOC_PROCESSING_QUEUE_URL=   # document extraction jobs → Document AI Lambda
SQS_WHATSAPP_DISPATCH_QUEUE_URL=# outbound WhatsApp messages → Notification Lambda
SQS_LLM_INFERENCE_QUEUE_URL=    # async LLM jobs

# ---- Events (EventBridge) ---------------------------------------------------
EVENT_BUS_NAME=                 # e.g. botstackhq-prod
FILING_SCHEDULER_RULE_PREFIX=   # rule-name prefix for EventBridge Scheduler

# ---- LLM providers (Secrets Manager refs in prod) ---------------------------
OPENAI_API_KEY_SECRET_NAME=     # primary: GPT-4o, embeddings
ANTHROPIC_API_KEY_SECRET_NAME=  # fallback: Claude Sonnet

# ---- WhatsApp (Meta Cloud API) ---------------------------------------------
WHATSAPP_API_BASE_URL=https://graph.facebook.com/v20.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_TOKEN_SECRET_NAME=             # long-lived access token
WHATSAPP_WEBHOOK_VERIFY_TOKEN_SECRET_NAME=

# ---- Internal service wiring -----------------------------------------------
DOCUMENT_AI_LAMBDA_NAME=        # Lambda function name for sync invokes (rare; default is SQS async)
FRONTEND_ORIGIN=http://localhost:5173  # CORS allowlist for the CA dashboard
