# EditorConfig — editor-level whitespace/EOL conventions, picked up before any
# format-on-save runs. Keeps Prettier as the single source of truth for code
# formatting; this file just ensures editors don't introduce CRLF/tabs/BOM
# noise on plain-text files Prettier doesn't touch.
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Python — 4-space indent per PEP 8.
[*.py]
indent_size = 4

# Markdown allows two trailing spaces to mean a line break.
[*.md]
trim_trailing_whitespace = false

# Makefiles require tab indentation.
[Makefile]
indent_style = tab
